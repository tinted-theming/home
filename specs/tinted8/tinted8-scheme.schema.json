                        {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "name": {
                                    "oneOf": [
                                        { "$ref": "#/$defs/color" },
                                        {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "class": { "$ref": "#/$defs/color" },
                                                "function": {
                                                    "oneOf": [
                                                        { "$ref": "#/$defs/color" },
                                                        {
                                                            "type": "object",
                                                            "additionalProperties": false,
                                                            "properties": {
                                                                "constructor": { "$ref": "#/$defs/color" }
                                                            }
                                                        }
                                                    ]
                                                },
                                                "label": { "$ref": "#/$defs/color" },
                                                "tag": { "$ref": "#/$defs/color" },
                                                "type": {
                                                    "oneOf": [
                                                        { "$ref": "#/$defs/color" },
                                                        {
                                                            "type": "object",
                                                            "additionalProperties": false,
                                                            "properties": {
                                                                "class": { "$ref": "#/$defs/color" },
                                                                "enum": { "$ref": "#/$defs/color" }
                                                            }
                                                        }
                                                    ]
                                                },
                                                "namespace": { "$ref": "#/$defs/color" },
                                                "section": { "$ref": "#/$defs/color" }
                                            }
                                        }
                                    ]
                                },
                                "other": {
                                    "oneOf": [
                                        { "$ref": "#/$defs/color" },
                                        {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "attribute-name": { "$ref": "#/$defs/color" },
                                                "inherited-class": { "$ref": "#/$defs/color" }
                                            }
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                },
                "keyword": {
                    "oneOf": [
                        { "$ref": "#/$defs/color" },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "control": {
