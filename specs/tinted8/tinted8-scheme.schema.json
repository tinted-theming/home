                                            "additionalProperties": false,
                                            "properties": {
                                                "single": { "$ref": "#/$defs/color" },
                                                "double": { "$ref": "#/$defs/color" }
                                            }
                                        }
                                    ]
                                },
                                "regexp": { "$ref": "#/$defs/color" },
                                "template": { "$ref": "#/$defs/color" },
                                "interpolated": { "$ref": "#/$defs/color" },
                                "unquoted": { "$ref": "#/$defs/color" },
                                "other": { "$ref": "#/$defs/color" }
                            }
                        }
                    ]
                },
                "constant": {
                    "oneOf": [
                        { "$ref": "#/$defs/color" },
                        {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "numeric": {
                                    "oneOf": [
                                        { "$ref": "#/$defs/color" },
                                        {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "integer": { "$ref": "#/$defs/color" },
                                                "float": { "$ref": "#/$defs/color" },
                                                "hex": { "$ref": "#/$defs/color" }
                                            }
                                        }
                                    ]
                                },
