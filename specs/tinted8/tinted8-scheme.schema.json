        "ui": {
            "title": "UI",
            "type": "object",
            "description": "UI theming properties. Not required because these values will be derived using the 'palette' object colors.",
            "additionalProperties": false,
            "properties": {
                "global": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "background": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "normal": { "$ref": "#/$defs/color" },
                                "dark": { "$ref": "#/$defs/color" },
                                "light": { "$ref": "#/$defs/color" }
