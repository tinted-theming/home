                                "function": { "$ref": "#/$defs/color" },
                                "class": { "$ref": "#/$defs/color" },
                                "block": { "$ref": "#/$defs/color" },
                                "tag": { "$ref": "#/$defs/color" },
                                "type": { "$ref": "#/$defs/color" },
